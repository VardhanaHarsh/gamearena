# GameArena — copy to .env and fill in secrets. NEVER commit .env.
# This is a virtual-credits prototype: there are no payment settings because there are no payments.

NODE_ENV=development
PORT=4000

# PostgreSQL (source of truth for every credit movement) and Redis (ephemeral state only)
POSTGRES_USER=gamearena
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=gamearena
DATABASE_URL=postgres://gamearena:change-me-local-only@localhost:5432/gamearena
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

CORS_ORIGINS=http://localhost:5173,http://localhost:8080
FRONTEND_URL=http://localhost:5173

# Must be "true" — the server refuses to start otherwise.
DEMO_MODE=true
# One-time welcome grant per account (virtual credits, no real value)
SIGNUP_BONUS_CREDITS=1000

TURN_SECONDS=25
RECONNECT_GRACE_SECONDS=60
LOG_LEVEL=info
